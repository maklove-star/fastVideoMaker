ARK_API_KEY=your_volc_ark_api_key
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_MODEL=doubao-seed-evolving
ARK_MAX_OUTPUT_TOKENS=4096
# Legacy alias (optional):
# GLM_MODEL=doubao-seed-evolving

DOUBAO_AUDIO_API_KEY=your_doubao_audio_api_key
DOUBAO_AUDIO_URL=https://openspeech.bytedance.com/api/v3/tts/create
DOUBAO_AUDIO_MODEL=seed-audio-1.0

# Volcengine speech console: https://console.volcengine.com/speech/service/10007
DOUBAO_TTS_APP_ID=your_app_id
DOUBAO_TTS_ACCESS_KEY=your_access_token
DOUBAO_TTS_SECRET_KEY=your_secret_key
DOUBAO_TTS_HTTP_URL=https://openspeech.bytedance.com/api/v1/tts
DOUBAO_TTS_V3_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_RESOURCE_ID=volc.service_type.10029
DOUBAO_TTS_DEFAULT_SPEAKER=zh_female_shuangkuaisisi_uranus_bigtts
DOUBAO_TTS_UID=digital-human-agent
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_ENCODING=mp3
DOUBAO_TTS_SPEED_RATIO=1.0
DOUBAO_TTS_VOLUME_RATIO=1.0
DOUBAO_TTS_PITCH_RATIO=1.0
DOUBAO_TTS_POLL_INTERVAL_SECONDS=3
DOUBAO_TTS_TIMEOUT_SECONDS=300
DOUBAO_TTS_MAX_CHUNK_BYTES=900
DOUBAO_TTS_PREFER_ASYNC_OVER_CHARS=600

# Douyin spoken-script ASR (flash). Uses the same AppID / Access Token as TTS.
DOUBAO_ASR_FLASH_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_ASR_TIMEOUT_SECONDS=180
DOUBAO_ASR_MAX_BYTES=20971520
# Douyin口播提取：model=豆包 input_video（推荐）| asr=Flash ASR | auto=先模型后ASR
DOUYIN_TRANSCRIPT_PROVIDER=model
DOUYIN_KEEP_TRANSCRIPT_FILES=false

# Video: HeyGen Image-to-Video（音频驱动口型）
# Docs: https://developers.heygen.com/image-to-video
# Quick start: https://developers.heygen.com/docs/quick-start
ENABLE_REAL_VIDEO=true
VIDEO_PROVIDER=heygen
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_API_BASE=https://api.heygen.com
HEYGEN_CREATE_PATH=/v3/videos
HEYGEN_QUERY_PATH=/v3/videos/{video_id}
HEYGEN_ASSETS_PATH=/v3/assets
HEYGEN_ASPECT_RATIO=auto
HEYGEN_POLL_INTERVAL_SECONDS=8
HEYGEN_TIMEOUT_SECONDS=900

# Optional fallback: Volcengine Visual 单图音频驱动 (VIDEO_PROVIDER=volc_cv)
# VOLC_ACCESS_KEY=AKLTxxxxxxxxxxxxxxxx
# VOLC_SECRET_KEY=your_secret_access_key
# VOLC_CV_MODE=normal
# PUBLIC_BASE_URL=
# PUBLIC_FILE_HOST=auto
